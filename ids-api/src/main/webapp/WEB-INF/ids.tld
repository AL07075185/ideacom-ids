<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>Etiquetas personalizadas de ideacom IDS</description>
    <tlib-version>1.0</tlib-version>
    <short-name>ids</short-name>
    <uri>http://ideacom.mx/ids/tags</uri>

    <tag>
        <description>Estado de un dispositivo como etiqueta de color</description>
        <name>estado</name>
        <tag-class>mx.ideacom.ids.api.web.EstadoTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <name>valor</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
        </attribute>
    </tag>

    <tag>
        <description>Porcentaje de disponibilidad con color segun el nivel</description>
        <name>porcentaje</name>
        <tag-class>mx.ideacom.ids.api.web.PorcentajeTag</tag-class>
        <body-content>empty</body-content>
        <attribute>
            <name>valor</name>
            <required>false</required>
            <rtexprvalue>true</rtexprvalue>
            <type>java.lang.Double</type>
        </attribute>
    </tag>
</taglib>
