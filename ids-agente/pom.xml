<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>mx.ideacom</groupId>
        <artifactId>ideacom-ids</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>ids-agente</artifactId>
    <packaging>jar</packaging>
    <name>ids-agente</name>
    <description>Agente ligero (solo Java estandar): alta automatica, latido y avisos de apagado</description>

    <dependencies>
        <dependency>
            <groupId>mx.ideacom</groupId>
            <artifactId>ids-common</artifactId>
        </dependency>
    </dependencies>

    <build>
        <!-- Genera target/ids-agente.jar, ejecutable con: java -jar ids-agente.jar agente.properties -->
        <finalName>ids-agente</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>mx.ideacom.ids.agente.AgenteMain</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <!-- Incluye ids-common dentro del JAR para que sea un solo archivo -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>mx.ideacom:ids-common</artifact>
                                    <excludes>
                                        <exclude>META-INF/MANIFEST.MF</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
